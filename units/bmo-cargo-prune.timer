[Unit]
Description=Prune of the shared Cargo build directory, every two hours
# docs/deploy.md, 「The Cargo build directory」.

[Timer]
OnCalendar=*-*-* 01/2:10:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
# Linked with its service, enabled and started by every deployment, and laid with its service, enabled and
# started on the placed machine as well (docs/deploy.md, 「The unit links」).
X-BMO-Deploy=timer
X-BMO-Placed=timer

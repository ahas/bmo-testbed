[Unit]
Description=Prune of the shared Cargo build directory where one is due, read every five minutes
# docs/deploy.md, 「The Cargo build directory」: its service prunes only where the directory stands over its
# ceiling or its last prune ended two hours ago or more.

[Timer]
OnCalendar=*-*-* *:00/5:00

[Install]
WantedBy=timers.target
# Linked with its service, enabled and started by every deployment, and laid with its service, enabled and
# started on the placed machine as well (docs/deploy.md, 「The unit links」).
X-BMO-Deploy=timer
X-BMO-Placed=timer

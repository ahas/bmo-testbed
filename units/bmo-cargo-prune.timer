[Unit]
Description=Prune of the shared Cargo build directory, every six hours
# docs/deploy.md, 「The Cargo build directory」.

[Timer]
OnCalendar=*-*-* 05,11,17,23:10:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
# Linked with its service, enabled and started by every deployment (docs/deploy.md, 「The unit links」).
X-BMO-Deploy=timer

[Unit]
Description=Data backup, every hour
# docs/backup.md, 「How a snapshot runs」.

[Timer]
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
# Linked with its service, enabled and started by every deployment (docs/deploy.md, 「The unit links」).
X-BMO-Deploy=timer
